# Zero Waste Food Rescue - Environment Configuration Template
# Copy this file to .env for local development, or add these variables in your deployment dashboard.

# Flask Secrets & Debug
SECRET_KEY=generate-a-strong-random-key-here-for-production
FLASK_DEBUG=False
PORT=5000

# Database Configuration
# Leave commented or empty to use local SQLite (instance/zero_waste.db)
# For production (PostgreSQL), provide the connection string:
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name
